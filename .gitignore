# Guardian's own data: NEVER commit these (they can hold quarantined files,
# your scan history and local settings)
.guardian/
guardian.db
quarantine/
*.quar
signatures.json
model.json
allowlist.json
feeds.json

# Test files that antivirus programs (correctly) flag
eicar*
*.eicar
samples/

# Reports generated by scans
report.html
report.json

# Secrets: an API key must never be committed
.env
.env.*
*.key
*.pem

# Editors and operating systems
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
